<%
  var ac = site.data.academic || {};
  var papers = Array.isArray(ac.papers) ? ac.papers : [];
  var socialLinks = Array.isArray(ac.social_links) ? ac.social_links : [];
  var bio = Array.isArray(ac.bio) ? ac.bio : [];
  var displayName = ac.name || config.author;
  var showResearch = ac.show_research === true;
  var featured = papers.find(function(paper) { return paper.highlight; });
  var regularPapers = papers.filter(function(paper) { return !paper.highlight; });

  function mdLinks(str) {
    if (!str) return '';
    return str.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  }

  function renderAuthors(authors) {
    if (!authors || !authors.length) return '';
    return authors.map(function(author) {
      if (author.me) return '<strong>' + author.name + '</strong>';
      if (author.url) return '<a href="' + author.url + '">' + author.name + '</a>';
      return author.name;
    }).join(', ');
  }

  function renderPaperLinks(paper) {
    var paperLinks = paper.links || [];
    if (!paperLinks.length && paper.url) {
      paperLinks = [{ text: 'paper', url: paper.url }];
    }
    return paperLinks;
  }
%>

<link rel="stylesheet" type="text/css" href="/academic/stylesheet.css">

<section class="academic-page" aria-label="Academic homepage">
  <header class="academic-hero">
    <div class="academic-hero-copy">
      <h1>
        <span class="academic-name-en"><%= displayName %></span>
        <% if (ac.name_zh) { %>
          <span class="academic-name-zh"><%= ac.name_zh %></span>
        <% } %>
      </h1>
      <p class="academic-tagline"><%= ac.tagline || 'Long-horizon video generation, world models, and visual intelligence.' %></p>

    </div>

    <div class="academic-profile">
      <a class="academic-avatar-link" href="<%= ac.avatar %>" aria-label="<%= displayName %> portrait">
        <img class="academic-avatar" src="<%= ac.avatar %>" alt="<%= displayName %>">
      </a>

<% if (socialLinks.length) { %>
        <nav class="academic-profile-social" aria-label="Contact and social profiles">
<% socialLinks.forEach(function(social) { %>
            <a class="academic-social-link" href="<%= social.url %>" aria-label="<%= social.label %>"<% if (/^https?:/.test(social.url)) { %> target="_blank" rel="noopener noreferrer"<% } %>>
              <svg class="academic-social-icon" viewBox="0 0 24 24" aria-hidden="true">
<% if (social.icon === 'email') { %>
                  <path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
<% } else if (social.icon === 'cv') { %>
                  <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M7 2.75h6.5L18 7.25V21.25H7a2 2 0 0 1-2-2V4.75a2 2 0 0 1 2-2ZM13.5 2.75v4.5H18" />
                  <path fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" d="M11 13.4a2.25 2.25 0 1 0 0 3.2M12.7 13l1.55 4 1.55-4" />
<% } else if (social.icon === 'linkedin') { %>
                  <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z" />
<% } else if (social.icon === 'blog') { %>
                  <image href="/images/favicon.svg" x="2" y="2" width="20" height="20" preserveAspectRatio="xMidYMid meet" />
<% } else if (social.icon === 'zhihu') { %>
                  <path fill="currentColor" d="M5.721 0C2.251 0 0 2.25 0 5.719V18.28C0 21.751 2.252 24 5.721 24h12.56C21.751 24 24 21.75 24 18.281V5.72C24 2.249 21.75 0 18.281 0zm1.964 4.078c-.271.73-.5 1.434-.68 2.11h4.587c.545-.006.445 1.168.445 1.171H9.384a58.104 58.104 0 0 1-.112 3.797h2.712c.388.023.393 1.251.393 1.266H9.183a9.223 9.223 0 0 1-.408 2.102l.757-.604c.452.456 1.512 1.712 1.906 2.177.473.681.063 2.081.063 2.081l-2.794-3.382c-.653 2.518-1.845 3.607-1.845 3.607-.523.468-1.58.82-2.64.516 2.218-1.73 3.44-3.917 3.667-6.497H4.491c0-.015.197-1.243.806-1.266h2.71c.024-.32.086-3.254.086-3.797H6.598c-.136.406-.158.447-.268.753-.594 1.095-1.603 1.122-1.907 1.155.906-1.821 1.416-3.6 1.591-4.064.425-1.124 1.671-1.125 1.671-1.125zM13.078 6h6.377v11.33h-2.573l-2.184 1.373-.401-1.373h-1.219zm1.313 1.219v8.86h.623l.263.937 1.455-.938h1.456v-8.86z" />
<% } else if (social.icon === 'misc') { %>
                  <rect x="3" y="3" width="7" height="7" rx="1" fill="currentColor" />
                  <rect x="14" y="3" width="7" height="7" rx="1" fill="currentColor" />
                  <rect x="3" y="14" width="7" height="7" rx="1" fill="currentColor" />
                  <rect x="14" y="14" width="7" height="7" rx="1" fill="currentColor" />
<% } %>
              </svg>
            </a>
<% }); %>
        </nav>
<% } %>
    </div>

    <% if (bio.length) { %>
      <section class="academic-bio" aria-label="Biography">
        <% bio.forEach(function(para) { %>
          <p><%- mdLinks(para) %></p>
        <% }); %>
      </section>
    <% } %>
  </header>

  <% if (showResearch) { %>
    <main class="academic-main">
      <section class="academic-section research-section" aria-labelledby="research-title">
        <div class="academic-section-header">
          <p class="academic-kicker">Selected Work</p>
          <h2 id="research-title">Research</h2>
        </div>

        <% if (featured) { %>
          <article class="featured-paper<% if (!(featured.image || featured.image_hover)) { %> featured-paper-no-media<% } %>">
            <% if (featured.image || featured.image_hover) { %>
              <a class="featured-paper-media" href="<%= featured.url || '#' %>">
                <img src="<%= featured.image_hover || featured.image %>" alt="<%= featured.title %> teaser">
              </a>
            <% } %>
            <div class="featured-paper-copy">
              <p class="academic-kicker">Featured Research</p>
              <% if (featured.url) { %>
                <a class="paper-title-link" href="<%= featured.url %>"><h3><%= featured.title %></h3></a>
              <% } else { %>
                <h3><%= featured.title %></h3>
              <% } %>
              <% if (featured.authors && featured.authors.length) { %>
                <p class="paper-authors"><%- renderAuthors(featured.authors) %></p>
              <% } %>
              <% if (featured.venue || featured.year || featured.awards) { %>
                <p class="paper-meta"><% if (featured.venue) { %><em><%= featured.venue %></em><% } %><% if (featured.year) { %>, <%= featured.year %><% } %><% if (featured.awards) { %> <strong><%= featured.awards %></strong><% } %></p>
              <% } %>
              <% if (featured.description) { %>
                <p class="paper-description"><%- mdLinks(featured.description) %></p>
              <% } %>
              <% var featuredLinks = renderPaperLinks(featured); %>
              <% if (featuredLinks.length) { %>
                <div class="paper-links">
                  <% featuredLinks.forEach(function(link) { %>
                    <a href="<%= link.url %>"><%= link.text %></a>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </article>
        <% } %>

        <% if (regularPapers.length) { %>
          <div class="paper-list">
            <% regularPapers.forEach(function(paper) { %>
              <article class="paper-card">
                <% if (paper.image || paper.image_hover) { %>
                  <a class="paper-media" href="<%= paper.url || '#' %>">
                    <img src="<%= paper.image_hover || paper.image %>" alt="<%= paper.title %> teaser">
                  </a>
                <% } else { %>
                  <div class="paper-media paper-media-placeholder" aria-hidden="true"></div>
                <% } %>
                <div class="paper-copy">
                  <% if (paper.url) { %>
                    <a class="paper-title-link" href="<%= paper.url %>"><h3><%= paper.title %></h3></a>
                  <% } else { %>
                    <h3><%= paper.title %></h3>
                  <% } %>
                  <% if (paper.authors && paper.authors.length) { %>
                    <p class="paper-authors"><%- renderAuthors(paper.authors) %></p>
                  <% } %>
                  <% if (paper.venue || paper.year || paper.awards) { %>
                    <p class="paper-meta"><% if (paper.venue) { %><em><%= paper.venue %></em><% } %><% if (paper.year) { %>, <%= paper.year %><% } %><% if (paper.awards) { %> <strong><%= paper.awards %></strong><% } %></p>
                  <% } %>
                  <% if (paper.description) { %>
                    <p class="paper-description"><%- mdLinks(paper.description) %></p>
                  <% } %>
                  <% var paperLinks = renderPaperLinks(paper); %>
                  <% if (paperLinks.length) { %>
                    <div class="paper-links">
                      <% paperLinks.forEach(function(link) { %>
                        <a href="<%= link.url %>"><%= link.text %></a>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else if (!featured) { %>
          <div class="empty-research">
            <p>Publications will appear here.</p>
          </div>
        <% } %>
      </section>
    </main>
  <% } %>

  <footer class="academic-footer">
    <span>&copy; <%= new Date().getFullYear() %> <%= displayName %>.</span>
  </footer>
</section>
