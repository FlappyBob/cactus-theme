<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title><%= site.data.academic.name %> — Academic</title>
  <meta name="author" content="<%= site.data.academic.name %>">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" type="text/css" href="/academic/stylesheet.css">
</head>
<body>
<%
  var ac = site.data.academic;
  var papers = ac.papers || [];
  var education = ac.education || [];
  var links = ac.links || [];
  var bio = ac.bio || [];

  // Simple markdown-link parser: [text](url) → <a href="url">text</a>
  function mdLinks(str) {
    if (!str) return '';
    return str.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  }
%>

<table style="width:100%;max-width:800px;border:0px;border-spacing:0px;border-collapse:separate;margin-right:auto;margin-left:auto;"><tbody>
  <tr style="padding:0px">
    <td style="padding:0px">

      <!-- ── Profile ─────────────────────────────────────────── -->
      <table style="width:100%;border:0px;border-spacing:0px;border-collapse:separate;margin-right:auto;margin-left:auto;"><tbody>
        <tr style="padding:0px">
          <td style="padding:2.5%;width:63%;vertical-align:middle">
            <p class="name" style="text-align:center;"><%= ac.name %></p>
            <% bio.forEach(function(para) { %>
              <p><%- mdLinks(para) %></p>
            <% }); %>
            <p style="text-align:center">
              <% links.forEach(function(link, i) { %>
                <a href="<%= link.url %>"><%= link.text %></a><% if (i < links.length - 1) { %> &nbsp;/&nbsp;<% } %>
              <% }); %>
            </p>
          </td>
          <td style="padding:2.5%;width:37%;max-width:37%">
            <a href="<%= ac.avatar %>">
              <img style="width:100%;max-width:100%;object-fit:cover;border-radius:50%;" alt="<%= ac.name %>" src="<%= ac.avatar %>">
            </a>
          </td>
        </tr>
      </tbody></table>

      <!-- ── Research intro ──────────────────────────────────── -->
      <table style="width:100%;border:0px;border-spacing:0px;border-collapse:separate;margin-right:auto;margin-left:auto;"><tbody>
        <tr>
          <td style="padding:16px;width:100%;vertical-align:middle">
            <h2>Research</h2>
            <p><%- mdLinks(ac.research_intro) %> <% if (papers.length > 0) { %>Some papers are <span class="highlight">highlighted</span>.<% } %></p>
          </td>
        </tr>
      </tbody></table>

      <!-- ── Papers ──────────────────────────────────────────── -->
      <table style="width:100%;border:0px;border-spacing:0px 10px;border-collapse:separate;margin-right:auto;margin-left:auto;"><tbody>

        <% if (papers.length === 0) { %>
        <tr>
          <td style="padding:16px;width:100%;vertical-align:middle;color:#bbb;font-style:italic;font-size:13px;">
            Publications will appear here.
          </td>
        </tr>
        <% } %>

        <% papers.forEach(function(paper) { %>
        <tr onmouseout="<%= paper.id %>_stop()" onmouseover="<%= paper.id %>_start()"<% if (paper.highlight) { %> bgcolor="#ffffd0"<% } %>>
          <td style="padding:16px;width:20%;vertical-align:middle">
            <div class="one">
              <% if (paper.image_hover) { %>
              <div class="two" id="<%= paper.id %>_image">
                <img src="<%= paper.image_hover %>" width="160">
              </div>
              <% } else { %>
              <div class="two" id="<%= paper.id %>_image"></div>
              <% } %>
              <% if (paper.image) { %>
              <img src="<%= paper.image %>" width="160">
              <% } %>
            </div>
            <script type="text/javascript">
              function <%= paper.id %>_start() { document.getElementById('<%= paper.id %>_image').style.opacity = "1"; }
              function <%= paper.id %>_stop()  { document.getElementById('<%= paper.id %>_image').style.opacity = "0"; }
              <%= paper.id %>_stop()
            </script>
          </td>
          <td style="padding:20px;width:75%;vertical-align:middle">
            <% if (paper.url) { %><a href="<%= paper.url %>"><% } %>
              <span class="papertitle"><%= paper.title %></span>
            <% if (paper.url) { %></a><% } %>
            <br>
            <% (paper.authors || []).forEach(function(author, i) { %>
              <% if (author.me) { %><strong><%= author.name %></strong><% } else if (author.url) { %><a href="<%= author.url %>"><%= author.name %></a><% } else { %><%= author.name %><% } %><% if (i < paper.authors.length - 1) { %>,&nbsp;<% } %>
            <% }); %>
            <br>
            <em><%= paper.venue %></em>, <%= paper.year %><% if (paper.awards) { %> &nbsp;<strong><%= paper.awards %></strong><% } %>
            <% if (paper.links && paper.links.length > 0) { %>
            <br>
            <% paper.links.forEach(function(link, i) { %><a href="<%= link.url %>"><%= link.text %></a><% if (i < paper.links.length - 1) { %> /&nbsp;<% } %><% }); %>
            <% } %>
            <% if (paper.description) { %>
            <p></p>
            <p><%- mdLinks(paper.description) %></p>
            <% } %>
          </td>
        </tr>
        <% }); %>

      </tbody></table>

      <!-- ── Education ───────────────────────────────────────── -->
      <table style="width:100%;border:0px;border-spacing:0px;border-collapse:separate;margin-right:auto;margin-left:auto;"><tbody>
        <tr>
          <td style="padding:16px;width:100%;vertical-align:middle">
            <h2>Education</h2>
          </td>
        </tr>
      </tbody></table>
      <table style="width:100%;border:0px;border-spacing:0px 10px;border-collapse:separate;margin-right:auto;margin-left:auto;"><tbody>
        <% education.forEach(function(edu) { %>
        <tr>
          <td style="padding:8px 16px;width:100%;vertical-align:middle">
            <span class="papertitle"><%= edu.school %></span><br>
            <span style="color:#555;"><%= edu.degree %><% if (edu.years) { %> &nbsp;·&nbsp; <%= edu.years %><% } %></span>
            <% if (edu.note) { %><br><span style="color:#888;font-size:13px;"><%= edu.note %></span><% } %>
          </td>
        </tr>
        <% }); %>
      </tbody></table>

    </td>
  </tr>
</tbody></table>

</body>
</html>
